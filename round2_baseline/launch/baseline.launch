<launch>
  <arg name="gui" default="true"/>
  <arg name="timer" default="true"/>
  <arg name="low_com" default="false"/>
  <arg name="speed_profile" default="stable"/>
  <arg name="timeout_clock" default="wall"/>
  <arg name="continuous_bends" default="false"/>
  <arg name="efficient_approach" default="false"/>
  <include file="$(find round2_baseline)/launch/simulation.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="low_com" value="$(arg low_com)"/>
  </include>
  <include file="$(find round2_baseline)/launch/control.launch">
    <arg name="speed_profile" value="$(arg speed_profile)"/>
    <arg name="continuous_bends" value="$(arg continuous_bends)"/>
    <arg name="efficient_approach" value="$(arg efficient_approach)"/>
    <arg name="timeout_clock" value="$(eval 'wall' if arg('timer') else arg('timeout_clock'))"/>
  </include>
  <include if="$(arg timer)" file="$(find ucar_accumtimer)/launch/AccumTimer.launch"/>
</launch>
