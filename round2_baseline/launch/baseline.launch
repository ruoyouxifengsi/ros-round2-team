<launch>
  <arg name="gui" default="true"/>
  <arg name="timer" default="true"/>
  <arg name="low_com" default="false"/>
  <arg name="speed_profile" default="stable"/>
  <arg name="timeout_clock" default="wall"/>
  <arg name="manual_supervision" default="false"/>
  <arg name="efficient_approach" default="false"/>
  <arg name="map_file" default=""/>
  <arg name="attitude_protection" default="false"/>
  <arg name="vision" default="true"/>
  <arg name="qr_preposition" default="true"/>
  <arg name="align_return" default="true"/>
  <arg name="play_audio" default="true"/>
  <arg name="vision_audio_device" default="plughw:1,0"/>
  <arg name="vision_evidence_root" default="$(env HOME)/vision_evidence"/>
  <include file="$(find round2_baseline)/launch/simulation.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="low_com" value="$(arg low_com)"/>
  </include>
  <include file="$(find round2_baseline)/launch/control.launch">
    <arg name="manual_supervision" value="$(arg manual_supervision)"/>
    <arg name="speed_profile" value="$(arg speed_profile)"/>
    <arg name="efficient_approach" value="$(arg efficient_approach)"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="attitude_protection" value="$(arg attitude_protection)"/>
    <arg name="vision" value="$(arg vision)"/>
    <arg name="qr_preposition" value="$(arg qr_preposition)"/>
    <arg name="align_return" value="$(arg align_return)"/>
    <arg name="play_audio" value="$(arg play_audio)"/>
    <arg name="vision_audio_device" value="$(arg vision_audio_device)"/>
    <arg name="vision_evidence_root" value="$(arg vision_evidence_root)"/>
    <arg name="timeout_clock" value="$(eval 'wall' if arg('timer') else arg('timeout_clock'))"/>
  </include>
  <include if="$(arg timer)" file="$(find ucar_accumtimer)/launch/AccumTimer.launch"/>
</launch>
