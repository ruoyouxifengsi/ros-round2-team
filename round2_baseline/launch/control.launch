<launch>
  <arg name="speed_profile" default="stable"/>
  <arg name="timeout_clock" default="wall"/>
  <arg name="manual_supervision" default="false"/>
  <arg name="flow_costmap_resolution" default="0.01"/>
  <arg name="hybrid_full" default="false"/>
  <arg name="hybrid_optimize" default="true"/>
  <arg name="hybrid_evidence" default=""/>
  <arg name="fixed_qr_trial" default="false"/>
  <arg name="efficient_approach" default="false"/>
  <arg name="map_file" default=""/>
  <arg name="attitude_protection" default="false"/>
  <arg name="vision" default="true"/>
  <arg name="qr_preposition" default="true"/>
  <arg name="block_preposition" default="false"/>
  <arg name="align_return" default="true"/>
  <arg name="play_audio" default="true"/>
  <arg name="vision_audio_device" default="plughw:1,0"/>
  <arg name="vision_evidence_root" default="$(env HOME)/vision_evidence"/>
  <include if="$(arg vision)" file="$(find round2_vision)/launch/vision.launch">
    <arg name="audio_device" value="$(arg vision_audio_device)"/>
    <arg name="play_audio" value="$(arg play_audio)"/>
    <arg name="evidence_root" value="$(arg vision_evidence_root)"/>
  </include>
  <group if="$(eval arg('map_file') != '')">
    <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)" output="screen" required="true"/>
    <node pkg="amcl" type="amcl" name="amcl" output="screen" required="true">
      <rosparam file="$(find round2_baseline)/config/amcl.yaml"/>
      <remap from="scan" to="/nav_scan"/>
    </node>
    <node pkg="round2_baseline" type="localized_odometry.py" name="localized_odometry" output="screen" required="true"/>
  </group>
  <node unless="$(arg fixed_qr_trial)" pkg="round2_baseline" type="cone_obstacles.py" name="cone_obstacles" output="screen">
    <param name="navigation_frame" value="$(eval 'map' if arg('map_file') else 'odom')"/>
  </node>
  <node unless="$(arg fixed_qr_trial)" pkg="move_base" type="move_base" name="move_base" output="screen" clear_params="true">
    <remap from="cmd_vel" to="nav_cmd_vel"/>
    <rosparam file="$(find round2_baseline)/config/navigation.yaml"/>
    <rosparam if="$(eval arg('speed_profile') == 'fast')" file="$(find round2_baseline)/config/speed_fast.yaml"/>
    <rosparam if="$(eval arg('speed_profile') == 'sprint')" file="$(find round2_baseline)/config/speed_sprint.yaml"/>
    <rosparam if="$(eval arg('map_file') != '')" file="$(find round2_baseline)/config/premapped_navigation.yaml"/>
    <param name="TebLocalPlannerROS/min_resolution_collision_check_angular" value="0.05"/>
    <param name="local_costmap/resolution" value="$(arg flow_costmap_resolution)"/>
    <param name="planner_frequency" value="1.0"/>
  </node>
  <node pkg="round2_baseline" type="attitude_guard.py" name="attitude_guard" output="screen">
    <param name="manual_supervision" value="$(arg manual_supervision)"/>
    <rosparam param="bend_settings" file="$(find round2_baseline)/config/bend_tracking.yaml"/>
    <param name="attitude_protection" value="$(arg attitude_protection)"/>
    <param name="max_linear_speed" value="$(eval 0.55 if arg('speed_profile') == 'sprint' else (0.45 if arg('speed_profile') == 'fast' else 0.3))"/>
    <param name="curvature_accel" value="$(eval 0.18 if arg('speed_profile') == 'sprint' else (0.12 if arg('speed_profile') == 'fast' else 0.0))"/>
    <param name="linear_acceleration" value="$(eval 0.65 if arg('speed_profile') == 'sprint' else 0.5)"/>
    <param name="hold_tilt_deg" value="3.0"/>
    <param name="angular_feedback" value="true"/>
  </node>
  <node pkg="round2_baseline" type="control.py" name="round2_control" output="screen">
    <param name="fixed_qr_trial" value="$(arg fixed_qr_trial)"/>
    <rosparam if="$(arg fixed_qr_trial)" ns="parking_geometry" file="$(find round2_baseline)/config/navigation.yaml"/>
    <param name="manual_supervision" value="$(arg manual_supervision)"/>
    <param name="navigation_frame" value="$(eval 'map' if arg('map_file') else 'odom')"/>
    <param name="pose_topic" value="$(eval '/localized_odom' if arg('map_file') else '/odom')"/>
    <param name="vision" value="$(arg vision)"/>
    <param name="qr_preposition" value="$(arg qr_preposition)"/>
    <rosparam param="flow_settings" file="$(find round2_baseline)/config/route_flow.yaml"/>
    <param name="hybrid_optimize" value="$(arg hybrid_optimize)"/>
    <param name="flow_settings/hybrid_full" value="$(eval arg('hybrid_full') and arg('map_file') == '')"/>
    <param name="hybrid_evidence" type="str" value="$(arg hybrid_evidence)"/>
    <param name="flow_settings/block_preposition" value="$(arg block_preposition)"/>
    <param name="flow_settings/align_return" value="$(arg align_return)"/>
    <rosparam param="bend_settings" file="$(find round2_baseline)/config/bend_tracking.yaml"/>
    <param name="efficient_approach" value="$(arg efficient_approach)"/>
    <param name="timeout_clock" value="$(arg timeout_clock)"/>
    <param name="speed_profile" value="$(arg speed_profile)"/>
    <rosparam param="route" file="$(find round2_baseline)/config/route.yaml"/>
  </node>
</launch>
