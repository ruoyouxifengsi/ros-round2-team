<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="qr_board_goods">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.15 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.3 0.3 0.005</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://qr_board_goods/materials/scripts/goods.material</uri>
