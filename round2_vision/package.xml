<?xml version="1.0"?>
<package format="2">
  <name>round2_vision</name>
  <version>0.1.0</version>
  <description>QR / block recognition and broadcast for round two smart car</description>
  <maintainer email="local@example.com">team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
